{
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  "features": {
    "ghcr.io/devcontainers/features/nix:1": {}
  },
  "mounts": [
    "source=${localEnv:HOME}/.local/share/opencode/auth.json,target=/home/vscode/.local/share/opencode/auth.json,type=bind",
    "source=${localWorkspaceFolder}/.hermes,target=/home/vscode/.hermes,type=bind",
  ],
  "remoteUser": "vscode",
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode",
  "postStartCommand": "~/dotfiles/tmux-init.sh"
}

