{
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  "features": {
    "ghcr.io/devcontainers/features/nix:1": {}
  },
  "runArgs": [
    "--privileged",
    "-v", "/Users/evgnskv/.local/share/opencode/auth.json:/home/vscode/.local/share/opencode/auth.json",
  ],
  "mounts": [
    "source=${env:HOME}/.ssh/config.d/og-infra,target=/etc/ssh/ssh_config.d/custom.conf,type=bind,readonly",
    "source=${env:HOME}/.ssh/hermes_og_ed25519,target=/home/vscode/.ssh/hermes_og_ed25519,type=bind,readonly",
    "source=${env:HOME}/.ssh/hermes_og_ed25519.pub,target=/home/vscode/.ssh/hermes_og_ed25519.pub,type=bind,readonly",
    "source=${localWorkspaceFolder}/.hermes,target=/home/vscode/.hermes,type=bind"
  ]
}

